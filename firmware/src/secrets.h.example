#pragma once

// Copie este arquivo para secrets.h e preencha com os seus dados.
// secrets.h esta no .gitignore e NUNCA deve ser versionado.

// Rede em que a ESP32 vai entrar. Precisa ser 2,4 GHz: a ESP32 nao enxerga
// redes de 5 GHz. Pode ser o hotspot do notebook ou um roteador comum,
// desde que o notebook que roda o Docker esteja na MESMA rede.
#define WIFI_SSID "NOME_DA_REDE"
#define WIFI_SENHA "SENHA_DA_REDE"

// IP do notebook que roda o Docker Compose (broker Mosquitto).
//
// NAO COPIE UM IP DAQUI. Ele muda conforme a rede e o valor errado e a causa
// mais comum de a placa conectar no Wi-Fi e nao aparecer nada no Grafana
// (o serial mostra "[mqtt] falhou (rc=-2)").
//
// Descubra o seu rodando, na raiz do projeto:
//
//     .\scripts\broker.ps1
//
// Ele testa a porta 1883 em cada interface e imprime a linha pronta para
// colar aqui. Se voce trocar de rede ou ligar o hotspot, rode de novo.
//
// Valores tipicos: hotspot do Windows 192.168.137.1, roteador de casa
// 192.168.0.x ou 192.168.1.x.
#define MQTT_HOST "PREENCHA_COM_O_IP_DO_NOTEBOOK"
#define MQTT_PORTA 1883
