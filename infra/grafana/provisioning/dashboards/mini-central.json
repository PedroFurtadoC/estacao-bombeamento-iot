      "type": "table",
      "title": "Últimas leituras",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-iot"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r.machine =~ /^${maquina:regex}$/)\n  |> pivot(rowKey: [\"_time\", \"machine\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 12)\n  |> keep(columns: [\"_time\", \"machine\", \"temperature\", \"vibration\", \"current\", \"rotation\", \"flow\", \"humidity\", \"gas\", \"status_code\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
